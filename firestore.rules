rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isEnrolled(courseId) {
      return signedIn() && exists(
        /databases/$(database)/documents/users/$(request.auth.uid)/enrollments/$(courseId)
      );
    }

    function ownsSession(sessionId) {
      return signedIn() &&
        get(/databases/$(database)/documents/chatSessions/$(sessionId)).data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow get, list: if isSelf(userId);
      allow create: if isSelf(userId) &&
        request.resource.data.keys().hasOnly([
          'email', 'displayName', 'lastSeenAt', 'createdAt', 'isAdmin'
        ]) &&
        request.resource.data.isAdmin == false;
      allow update: if isSelf(userId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'displayName', 'lastSeenAt'
        ]);
      allow delete: if false;

      match /enrollments/{courseId} {
        allow read: if isSelf(userId);
        allow create: if isSelf(userId) &&
          request.resource.data.courseId == courseId &&
          exists(/databases/$(database)/documents/courses/$(courseId)) &&
          request.resource.data.keys().hasOnly([
            'courseId', 'courseName', 'enrolledAt', 'lastAccessedAt', 'favorite', 'colorId'
          ]);
        allow update: if isSelf(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastAccessedAt', 'favorite', 'colorId'
          ]);
        allow delete: if isSelf(userId);
      }

      match /rateLimits/{document=**} {
        allow read, write: if false;
      }
    }

    // Course metadata is shared with authenticated extension users. Materials
    // are available to users who enroll in that course from the extension.
    match /courses/{courseId} {
      allow read: if signedIn();
      allow create: if signedIn() &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.fileSearchStoreName == null &&
        request.resource.data.keys().hasOnly([
          'courseName', 'courseCode', 'canvasUrl', 'canvasInstance',
          'firstScannedAt', 'lastScannedAt', 'fileSearchStoreName',
          'totalEnrollments', 'createdBy'
        ]);
      allow update: if (signedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lastScannedAt'
          ])) ||
        (isEnrolled(courseId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'totalEnrollments'
          ]));
      allow delete: if false;

      match /documents/{documentId} {
        allow read: if isEnrolled(courseId);
        allow create: if isEnrolled(courseId) &&
          request.resource.data.keys().hasOnly([
            'fileName', 'fileUrl', 'fileSize', 'fileType', 'scannedFrom',
            'uploadedAt', 'fileSearchDocumentName', 'uploadStatus',
            'lastUpdatedAt', 'uploadedToFileSearchAt'
          ]);
        allow update: if isEnrolled(courseId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'fileName', 'fileUrl', 'fileSize', 'fileType', 'scannedFrom',
            'uploadedAt', 'fileSearchDocumentName', 'uploadStatus',
            'lastUpdatedAt', 'uploadedToFileSearchAt'
          ]);
        allow delete: if isEnrolled(courseId);
      }
    }

    match /chatSessions/{sessionId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'userId', 'courseId', 'title', 'createdAt', 'lastMessageAt', 'messageCount'
        ]);
      allow update: if signedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'title', 'lastMessageAt', 'messageCount'
        ]);

      match /messages/{messageId} {
        allow read, delete: if ownsSession(sessionId);
        allow create: if ownsSession(sessionId) &&
          request.resource.data.keys().hasOnly(['role', 'content', 'timestamp']) &&
          request.resource.data.role in ['user', 'assistant'];
        allow update: if false;
      }
    }

    match /userUsageLimits/{userId} {
      allow read: if isSelf(userId);
      allow write: if false;
    }

    match /usageLimitConfig/{document=**} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
